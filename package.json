{
  "name": "create-database-chat",
  "version": "0.1.0",
  "description": "Scaffold a natural-language database chat app powered by LLM + your DB",
  "type": "module",
  "bin": {
    "create-database-chat": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [
    "cli",
    "scaffold",
    "create-app",
    "llm",
    "claude",
    "gemini",
    "codex",
    "database",
    "chat",
    "natural-language",
    "mongodb",
    "mysql",
    "postgresql",
    "oracle",
    "mssql",
    "sql"
  ],
  "author": "timonPark <m05214@naver.com>",
  "license": "MIT",
  "homepage": "https://github.com/timonPark/database-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timonPark/database-chat.git"
  },
  "bugs": {
    "url": "https://github.com/timonPark/database-chat/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
