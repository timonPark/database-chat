{
  "db": "mongodb",
  "sample": {
    "name": "Atlas Sample Datasets (sample_data, 23개 컬렉션 — 케이스는 mflix_*)",
    "seed": "npm run seed → MongoDB Atlas sampledata.archive 를 sample_data 한 DB 로 통합 적재 (컬렉션명 <원본DB>_<컬렉션>), DB_DATABASE=sample_data",
    "tables": ["mflix_movies", "mflix_comments", "mflix_users", "mflix_theaters", "mflix_sessions", "mflix_embedded_movies"]
  },
  "notes": [
    "케이스에 쓰는 필드: mflix_movies(_id, title, year, runtime, rated, genres, cast, directors, imdb, …) · mflix_comments(_id, name, email, movie_id, text, date) · mflix_users(_id, name, email, password)",
    "관계: mflix_comments.movie_id → mflix_movies._id · mflix_comments.email → mflix_users.email (이름 name · email 이 두 컬렉션에 같이 있음)",
    "스키마 파일은 collections/<컬렉션>.md. 파일의 필드 목록에 _id 행이 있어야 _id 가 매칭된다",
    "mflix_users.password 는 서버가 결과에서 제외한다 (민감 필드)",
    "$lookup 결과는 $unwind 로 객체가 돼야 movie.title 처럼 펼쳐서 매칭된다 (배열 그대로면 해당 key 는 미매칭)",
    "$project · $group · $addFields 등 문서 형태를 바꾸는 stage 가 있으면 현재 설계상 columnConfidence 는 항상 partial (shape breaker). 단 $replaceRoot 로 lookup 컬렉션이 새 루트가 되면 다시 full"
  ],
  "chat": [
    { "id": "TC-01", "category": "회귀", "question": "영화 목록 5개 보여줘",
      "expect": { "confidence": "full", "tables": ["mflix_movies"] } },
    { "id": "TC-02", "category": "회귀 · 필터", "question": "2015년에 개봉한 영화 제목과 상영시간 보여줘",
      "expect": { "confidence": "full", "allowPartial": "LLM 이 $project 로 모양을 바꾸면 partial (현재 설계)", "tables": ["mflix_movies"], "sources": { "title": "mflix_movies", "runtime": "mflix_movies" } } },
    { "id": "TC-03", "category": "회귀 · 민감 필드", "question": "사용자 목록 보여줘",
      "expect": { "confidence": "full", "tables": ["mflix_users"], "absentKeys": ["password"] } },
    { "id": "TC-04", "category": "$lookup", "question": "최근 영화 댓글을 영화 제목과 같이 보여줘",
      "expect": { "confidence": "full", "allowPartial": "LLM 이 $project 로 모양을 바꾸면 partial (현재 설계)", "tables": ["mflix_comments", "mflix_movies"] } },
    { "id": "TC-05", "category": "$lookup · 동명 필드", "question": "Ned Stark 가 댓글을 단 영화 제목과 댓글 내용 보여줘",
      "expect": { "confidence": "full", "allowPartial": "LLM 이 $project 로 모양을 바꾸면 partial (현재 설계)", "tables": ["mflix_comments", "mflix_movies", "mflix_users"] } },
    { "id": "TC-06", "category": "집계", "question": "관람 등급별 영화 수 알려줘",
      "expect": { "confidence": "partial", "tables": ["mflix_movies"] } },
    { "id": "TC-07", "category": "집계 · $lookup", "question": "댓글을 가장 많이 단 사용자 5명 보여줘",
      "expect": { "confidence": "partial", "tables": ["mflix_comments", "mflix_users"] } },
    { "id": "TC-08", "category": "결과 0건", "question": "3000년 이후에 개봉한 영화 보여줘",
      "expect": { "confidence": "full", "tables": ["mflix_movies"], "count": 0 } }
  ],
  "direct": [
    { "id": "D-01", "category": "find · projection", "endpoint": "/db-query",
      "body": { "collection": "mflix_movies", "filter": { "year": 2015 }, "projection": { "_id": 0, "title": 1, "year": 1, "runtime": 1 }, "limit": 5 },
      "expect": { "confidence": "full", "allFrom": "mflix_movies" } },
    { "id": "D-02", "category": "find · 전체 필드", "endpoint": "/db-query",
      "body": { "collection": "mflix_comments", "filter": {}, "limit": 5 },
      "expect": { "confidence": "full", "allFrom": "mflix_comments" } },
    { "id": "D-03", "category": "$lookup + $unwind", "endpoint": "/db-aggregate",
      "body": { "collection": "mflix_comments", "pipeline": [
        { "$lookup": { "from": "mflix_movies", "localField": "movie_id", "foreignField": "_id", "as": "movie" } },
        { "$unwind": "$movie" },
        { "$limit": 5 } ] },
      "expect": { "confidence": "full", "sources": { "text": "mflix_comments", "name": "mflix_comments", "movie.title": "mflix_movies", "movie.year": "mflix_movies" } } },
    { "id": "D-04", "category": "$lookup 2개 · 동명 필드", "endpoint": "/db-aggregate",
      "body": { "collection": "mflix_comments", "pipeline": [
        { "$lookup": { "from": "mflix_movies", "localField": "movie_id", "foreignField": "_id", "as": "movie" } },
        { "$unwind": "$movie" },
        { "$lookup": { "from": "mflix_users", "localField": "email", "foreignField": "email", "as": "user" } },
        { "$unwind": "$user" },
        { "$limit": 5 } ] },
      "expect": { "confidence": "full", "sources": { "name": "mflix_comments", "email": "mflix_comments", "user.name": "mflix_users", "user.email": "mflix_users", "movie.title": "mflix_movies" }, "absentKeys": ["user.password"] } },
    { "id": "D-05", "category": "$replaceRoot (lookup 컬렉션이 루트)", "endpoint": "/db-aggregate",
      "body": { "collection": "mflix_comments", "pipeline": [
        { "$lookup": { "from": "mflix_movies", "localField": "movie_id", "foreignField": "_id", "as": "movie" } },
        { "$unwind": "$movie" },
        { "$replaceRoot": { "newRoot": "$movie" } },
        { "$limit": 5 } ] },
      "expect": { "confidence": "full", "allFrom": "mflix_movies" } },
    { "id": "D-06", "category": "$group $first → $replaceRoot (#181)", "endpoint": "/db-aggregate",
      "body": { "collection": "mflix_comments", "pipeline": [
        { "$lookup": { "from": "mflix_users", "localField": "email", "foreignField": "email", "as": "user" } },
        { "$unwind": "$user" },
        { "$group": { "_id": "$user._id", "user": { "$first": "$user" } } },
        { "$replaceRoot": { "newRoot": "$user" } },
        { "$limit": 5 } ] },
      "expect": { "confidence": "full", "allFrom": "mflix_users", "absentKeys": ["password"] } },
    { "id": "D-07", "category": "$group 집계", "endpoint": "/db-aggregate",
      "body": { "collection": "mflix_movies", "pipeline": [
        { "$group": { "_id": "$rated", "movieCount": { "$sum": 1 }, "avgRuntime": { "$avg": "$runtime" } } },
        { "$limit": 10 } ] },
      "expect": { "confidence": "partial", "unmappedIncludes": ["movieCount", "avgRuntime"] } },
    { "id": "D-08", "category": "$project (shape breaker)", "endpoint": "/db-aggregate",
      "body": { "collection": "mflix_movies", "pipeline": [
        { "$project": { "_id": 0, "title": 1, "year": 1 } },
        { "$limit": 5 } ] },
      "expect": { "confidence": "partial", "sources": { "title": "mflix_movies", "year": "mflix_movies" }, "unmapped": [] },
      "note": "모든 key 가 매칭돼도 $project 가 있으면 partial — 현재 설계 (변경 시 이 케이스 갱신)" },
    { "id": "D-09", "category": "$lookup 배열 그대로", "endpoint": "/db-aggregate",
      "body": { "collection": "mflix_comments", "pipeline": [
        { "$lookup": { "from": "mflix_movies", "localField": "movie_id", "foreignField": "_id", "as": "movie" } },
        { "$limit": 5 } ] },
      "expect": { "confidence": "partial", "sources": { "text": "mflix_comments" }, "unmapped": ["movie"] },
      "note": "$unwind 없이 배열이면 movie 는 미매칭 — 현재 설계" },
    { "id": "D-10", "category": "결과 0건 헤더", "endpoint": "/db-query",
      "body": { "collection": "mflix_movies", "filter": { "year": { "$gt": 3000 } }, "projection": { "title": 1, "year": 1 }, "limit": 5 },
      "expect": { "confidence": "full", "count": 0, "keys": ["title", "year"], "allFrom": "mflix_movies" } },
    { "id": "D-11", "category": "민감 필드", "endpoint": "/db-query",
      "body": { "collection": "mflix_users", "filter": {}, "limit": 5 },
      "expect": { "confidence": "full", "allFrom": "mflix_users", "absentKeys": ["password"] } }
  ]
}
