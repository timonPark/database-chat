PORT=3111

DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=your-service-name
DB_USER_NAME=your-user
DB_USER_PASSWORD=your-password

TABLE_MAPPING_FILE=./table-mapping.md

# Codex 모델
CODEX_MODEL=gpt-5.6-luna

# Codex CLI 경로 (PATH에 codex가 없을 때만 지정)
# ChatGPT 앱 업데이트로 경로가 바뀔 수 있어 기본값은 PATH 를 사용합니다.
# CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex
