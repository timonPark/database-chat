{
  "db": "mongodb",
  "sample": {
    "name": "sample.json (users · products · orders)",
    "seed": "npm run seed → seeds/mongodb/sample.json 을 DB_DATABASE (기본 mydb) 에 적재",
    "tables": ["users", "products", "orders"]
  },
  "notes": [
    "필드: users(id, name, email, age, city, joinedAt) · products(id, name, category, price, stock, rating) · orders(id, userId, productId, quantity, amount, status, orderedAt) + 각 문서의 _id",
    "스키마 파일은 collections/<컬렉션>.md. 파일의 필드 목록에 _id 행이 있어야 _id 가 매칭된다",
    "$lookup 결과는 $unwind 로 객체가 돼야 user.name 처럼 펼쳐서 매칭된다 (배열 그대로면 해당 key 는 미매칭)",
    "$project · $group · $addFields 등 문서 형태를 바꾸는 stage 가 있으면 현재 설계상 columnConfidence 는 항상 partial (shape breaker). 단 $replaceRoot 로 lookup 컬렉션이 새 루트가 되면 다시 full"
  ],
  "chat": [
    { "id": "TC-01", "category": "회귀", "question": "사용자 목록 보여줘",
      "expect": { "confidence": "full", "tables": ["users"] } },
    { "id": "TC-02", "category": "회귀 · 필터", "question": "서울에 사는 사용자 이름과 이메일 보여줘",
      "expect": { "confidence": "full", "tables": ["users"], "sources": { "name": "users", "email": "users" } } },
    { "id": "TC-03", "category": "회귀 · 정렬", "question": "가격이 비싼 상품 5개 보여줘",
      "expect": { "confidence": "full", "tables": ["products"], "sources": { "price": "products" } } },
    { "id": "TC-04", "category": "$lookup", "question": "주문 내역을 주문한 사용자 이름과 같이 보여줘",
      "expect": { "confidence": "full", "allowPartial": "LLM 이 $project 로 모양을 바꾸면 partial (현재 설계)", "tables": ["orders", "users"] } },
    { "id": "TC-05", "category": "$lookup · 동명 필드", "question": "주문별로 사용자 이름과 상품 이름을 같이 보여줘",
      "expect": { "confidence": "full", "allowPartial": "LLM 이 $project 로 모양을 바꾸면 partial (현재 설계)", "tables": ["orders", "users", "products"] } },
    { "id": "TC-06", "category": "집계", "question": "주문 상태별 주문 건수 알려줘",
      "expect": { "confidence": "partial", "tables": ["orders"] } },
    { "id": "TC-07", "category": "집계 · $lookup", "question": "주문 금액 합계가 가장 큰 사용자 5명 보여줘",
      "expect": { "confidence": "partial", "tables": ["orders", "users"] } },
    { "id": "TC-08", "category": "결과 0건", "question": "나이가 200살 이상인 사용자 보여줘",
      "expect": { "confidence": "full", "tables": ["users"], "count": 0 } }
  ],
  "direct": [
    { "id": "D-01", "category": "find · projection", "endpoint": "/db-query",
      "body": { "collection": "users", "filter": { "city": "서울" }, "projection": { "_id": 0, "name": 1, "email": 1, "city": 1 }, "limit": 5 },
      "expect": { "confidence": "full", "allFrom": "users" } },
    { "id": "D-02", "category": "find · 전체 필드", "endpoint": "/db-query",
      "body": { "collection": "orders", "filter": {}, "limit": 5 },
      "expect": { "confidence": "full", "allFrom": "orders" } },
    { "id": "D-03", "category": "$lookup + $unwind", "endpoint": "/db-aggregate",
      "body": { "collection": "orders", "pipeline": [
        { "$lookup": { "from": "users", "localField": "userId", "foreignField": "id", "as": "user" } },
        { "$unwind": "$user" },
        { "$limit": 5 } ] },
      "expect": { "confidence": "full", "sources": { "amount": "orders", "status": "orders", "user.name": "users", "user.email": "users" } } },
    { "id": "D-04", "category": "$lookup 2개 · 동명 필드", "endpoint": "/db-aggregate",
      "body": { "collection": "orders", "pipeline": [
        { "$lookup": { "from": "users", "localField": "userId", "foreignField": "id", "as": "user" } },
        { "$unwind": "$user" },
        { "$lookup": { "from": "products", "localField": "productId", "foreignField": "id", "as": "product" } },
        { "$unwind": "$product" },
        { "$limit": 5 } ] },
      "expect": { "confidence": "full", "sources": { "quantity": "orders", "user.name": "users", "product.name": "products", "product.price": "products" } } },
    { "id": "D-05", "category": "$replaceRoot (lookup 컬렉션이 루트)", "endpoint": "/db-aggregate",
      "body": { "collection": "orders", "pipeline": [
        { "$match": { "status": "completed" } },
        { "$lookup": { "from": "products", "localField": "productId", "foreignField": "id", "as": "product" } },
        { "$unwind": "$product" },
        { "$replaceRoot": { "newRoot": "$product" } },
        { "$limit": 5 } ] },
      "expect": { "confidence": "full", "allFrom": "products" } },
    { "id": "D-06", "category": "$group $first → $replaceRoot (#181)", "endpoint": "/db-aggregate",
      "body": { "collection": "orders", "pipeline": [
        { "$lookup": { "from": "users", "localField": "userId", "foreignField": "id", "as": "user" } },
        { "$unwind": "$user" },
        { "$group": { "_id": "$user.id", "user": { "$first": "$user" } } },
        { "$replaceRoot": { "newRoot": "$user" } },
        { "$limit": 5 } ] },
      "expect": { "confidence": "full", "allFrom": "users" } },
    { "id": "D-07", "category": "$group 집계", "endpoint": "/db-aggregate",
      "body": { "collection": "orders", "pipeline": [
        { "$group": { "_id": "$status", "totalAmount": { "$sum": "$amount" }, "orderCount": { "$sum": 1 } } },
        { "$limit": 10 } ] },
      "expect": { "confidence": "partial", "unmappedIncludes": ["totalAmount", "orderCount"] } },
    { "id": "D-08", "category": "$project (shape breaker)", "endpoint": "/db-aggregate",
      "body": { "collection": "users", "pipeline": [
        { "$project": { "_id": 0, "name": 1, "city": 1 } },
        { "$limit": 5 } ] },
      "expect": { "confidence": "partial", "sources": { "name": "users", "city": "users" }, "unmapped": [] },
      "note": "모든 key 가 매칭돼도 $project 가 있으면 partial — 현재 설계 (변경 시 이 케이스 갱신)" },
    { "id": "D-09", "category": "$lookup 배열 그대로", "endpoint": "/db-aggregate",
      "body": { "collection": "orders", "pipeline": [
        { "$lookup": { "from": "users", "localField": "userId", "foreignField": "id", "as": "user" } },
        { "$limit": 5 } ] },
      "expect": { "confidence": "partial", "sources": { "amount": "orders" }, "unmapped": ["user"] },
      "note": "$unwind 없이 배열이면 user 는 미매칭 — 현재 설계" },
    { "id": "D-10", "category": "결과 0건 헤더", "endpoint": "/db-query",
      "body": { "collection": "users", "filter": { "age": { "$gt": 200 } }, "projection": { "name": 1, "age": 1 }, "limit": 5 },
      "expect": { "confidence": "full", "count": 0, "keys": ["name", "age"], "allFrom": "users" } }
  ]
}
